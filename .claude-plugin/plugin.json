{
  "name": "knowledge-catalog",
  "version": "0.5.4",
  "description": "Connect to Knowledge Catalog to discover, manage, monitor, and govern data and AI artifacts across your data platform",
  "author": {
    "name": "Google LLC",
    "email": "data-cloud-ai-integrations@google.com"
  },
  "homepage": "https://cloud.google.com/dataplex",
  "repository": "https://github.com/gemini-cli-extensions/knowledge-catalog",
  "license": "Apache-2.0",
  "userConfig": {
    "dataplex_project": {
      "title": "Project ID",
      "description": "ID of the Google Cloud project",
      "type": "string",
      "sensitive": false
    }
  },
  "mcpServers": {
    "dataplex": {
      "command": "npx",
      "args": [
        "-y",
        "@toolbox-sdk/server@1.9.0",
        "--prebuilt",
        "dataplex",
        "--stdio"
      ],
      "env": {
        "DATAPLEX_PROJECT": "${user_config.dataplex_project}"
      }
    }
  }
}
